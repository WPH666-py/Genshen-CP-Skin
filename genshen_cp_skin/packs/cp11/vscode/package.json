{
  "name": "genshen-skin-cp11",
  "displayName": "原神CP11 — 胡桃×香菱",
  "description": "原神 CP 壁纸套件1: 单张样式壁纸一键切换 · 桌面桌宠 · 多 IDE 皮肤",
  "version": "0.1.0",
  "publisher": "wp666",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WPH666-py/Genshen-skin-CP11.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "genshencp11.openGallery",
        "title": "原神CP11: 打开皮肤画廊"
      },
      {
        "command": "genshencp11.set1",
        "title": "原神CP11: 第1张 · 料理"
      },
      {
        "command": "genshencp11.set2",
        "title": "原神CP11: 第2张 · 锅巴"
      },
      {
        "command": "genshencp11.set3",
        "title": "原神CP11: 第3张 · 夜市"
      },
      {
        "command": "genshencp11.setCard",
        "title": "原神CP11: 卡片式(默认)"
      },
      {
        "command": "genshencp11.setCover",
        "title": "原神CP11: 满屏(cover 铺满)"
      },
      {
        "command": "genshencp11.setShowall",
        "title": "原神CP11: 完整(不裁切)"
      },
      {
        "command": "genshencp11.setRandom",
        "title": "原神CP11: 随机换一张"
      },
      {
        "command": "genshencp11.openSwitcher",
        "title": "原神CP11: 打开壁纸切换器"
      },
      {
        "command": "genshencp11.startPet",
        "title": "原神CP11: 启动桌面桌宠"
      },
      {
        "command": "genshencp11.generateAll",
        "title": "原神CP11: 生成全部样式(含 JetBrains 背景图)"
      },
      {
        "command": "genshencp11.showInfo",
        "title": "原神CP11: 环境自检"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "genshencp11",
          "title": "原神CP11",
          "icon": "media/genshencp11.svg"
        }
      ]
    },
    "views": {
      "genshencp11": [
        {
          "id": "genshencp11.gallery",
          "name": "皮肤画廊",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Genshin Skin CP1",
      "properties": {
        "genshencp11.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 解释器路径。留空自动查找 python / python3。"
        },
        "genshencp11.repoPath": {
          "type": "string",
          "default": "",
          "description": "仓库路径(含 src/genshen_skin_cp11 或 tools/wallpaper.py)。留空自动查找 pip 安装与常见克隆位置。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node prepack.js"
  }
}
