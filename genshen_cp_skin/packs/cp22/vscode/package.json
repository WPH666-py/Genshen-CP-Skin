{
  "name": "genshen-skin-cp22",
  "displayName": "原神CP22 — 荧×达达利亚",
  "description": "原神 CP 壁纸套件1: 单张样式壁纸一键切换 · 桌面桌宠 · 多 IDE 皮肤",
  "version": "0.1.0",
  "publisher": "wp666",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WPH666-py/Genshen-skin-CP22.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "genshencp22.openGallery",
        "title": "原神CP22: 打开皮肤画廊"
      },
      {
        "command": "genshencp22.setCard",
        "title": "原神CP22: 卡片式(默认)"
      },
      {
        "command": "genshencp22.setCover",
        "title": "原神CP22: 满屏(cover 铺满)"
      },
      {
        "command": "genshencp22.setShowall",
        "title": "原神CP22: 完整(不裁切)"
      },
      {
        "command": "genshencp22.setRandom",
        "title": "原神CP22: 随机换一种"
      },
      {
        "command": "genshencp22.openSwitcher",
        "title": "原神CP22: 打开壁纸切换器"
      },
      {
        "command": "genshencp22.startPet",
        "title": "原神CP22: 启动桌面桌宠"
      },
      {
        "command": "genshencp22.generateAll",
        "title": "原神CP22: 生成全部样式(含 JetBrains 背景图)"
      },
      {
        "command": "genshencp22.showInfo",
        "title": "原神CP22: 环境自检"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "genshencp22",
          "title": "原神CP22",
          "icon": "media/genshencp22.svg"
        }
      ]
    },
    "views": {
      "genshencp22": [
        {
          "id": "genshencp22.gallery",
          "name": "皮肤画廊",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Genshin Skin CP1",
      "properties": {
        "genshencp22.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 解释器路径。留达达利亚自动查找 python / python3。"
        },
        "genshencp22.repoPath": {
          "type": "string",
          "default": "",
          "description": "仓库路径(含 src/genshen_skin_cp22 或 tools/wallpaper.py)。留达达利亚自动查找 pip 安装与常见克隆位置。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node prepack.js"
  }
}
