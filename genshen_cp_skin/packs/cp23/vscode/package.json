{
  "name": "genshen-skin-cp23",
  "displayName": "原神CP23 — 荧×诺艾尔",
  "description": "原神 CP 壁纸套件1: 单张样式壁纸一键切换 · 桌面桌宠 · 多 IDE 皮肤",
  "version": "0.1.0",
  "publisher": "wp666",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WPH666-py/Genshen-skin-CP23.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "genshencp23.openGallery",
        "title": "原神CP23: 打开皮肤画廊"
      },
      {
        "command": "genshencp23.setCard",
        "title": "原神CP23: 卡片式(默认)"
      },
      {
        "command": "genshencp23.setCover",
        "title": "原神CP23: 满屏(cover 铺满)"
      },
      {
        "command": "genshencp23.setShowall",
        "title": "原神CP23: 完整(不裁切)"
      },
      {
        "command": "genshencp23.setRandom",
        "title": "原神CP23: 随机换一种"
      },
      {
        "command": "genshencp23.openSwitcher",
        "title": "原神CP23: 打开壁纸切换器"
      },
      {
        "command": "genshencp23.startPet",
        "title": "原神CP23: 启动桌面桌宠"
      },
      {
        "command": "genshencp23.generateAll",
        "title": "原神CP23: 生成全部样式(含 JetBrains 背景图)"
      },
      {
        "command": "genshencp23.showInfo",
        "title": "原神CP23: 环境自检"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "genshencp23",
          "title": "原神CP23",
          "icon": "media/genshencp23.svg"
        }
      ]
    },
    "views": {
      "genshencp23": [
        {
          "id": "genshencp23.gallery",
          "name": "皮肤画廊",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Genshin Skin CP1",
      "properties": {
        "genshencp23.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 解释器路径。留诺艾尔自动查找 python / python3。"
        },
        "genshencp23.repoPath": {
          "type": "string",
          "default": "",
          "description": "仓库路径(含 src/genshen_skin_cp23 或 tools/wallpaper.py)。留诺艾尔自动查找 pip 安装与常见克隆位置。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node prepack.js"
  }
}
