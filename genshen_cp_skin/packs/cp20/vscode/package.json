{
  "name": "genshen-skin-cp20",
  "displayName": "原神CP20 — 散兵×荧",
  "description": "原神 CP 壁纸套件1: 单张样式壁纸一键切换 · 桌面桌宠 · 多 IDE 皮肤",
  "version": "0.1.0",
  "publisher": "wp666",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WPH666-py/Genshen-skin-CP20.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "genshencp20.openGallery",
        "title": "原神CP20: 打开皮肤画廊"
      },
      {
        "command": "genshencp20.set1",
        "title": "原神CP20: 第1张 · 触碰"
      },
      {
        "command": "genshencp20.set2",
        "title": "原神CP20: 第2张 · 依偎"
      },
      {
        "command": "genshencp20.set3",
        "title": "原神CP20: 第3张 · 水畔"
      },
      {
        "command": "genshencp20.setCard",
        "title": "原神CP20: 卡片式(默认)"
      },
      {
        "command": "genshencp20.setCover",
        "title": "原神CP20: 满屏(cover 铺满)"
      },
      {
        "command": "genshencp20.setShowall",
        "title": "原神CP20: 完整(不裁切)"
      },
      {
        "command": "genshencp20.setRandom",
        "title": "原神CP20: 随机换一张"
      },
      {
        "command": "genshencp20.openSwitcher",
        "title": "原神CP20: 打开壁纸切换器"
      },
      {
        "command": "genshencp20.startPet",
        "title": "原神CP20: 启动桌面桌宠"
      },
      {
        "command": "genshencp20.generateAll",
        "title": "原神CP20: 生成全部样式(含 JetBrains 背景图)"
      },
      {
        "command": "genshencp20.showInfo",
        "title": "原神CP20: 环境自检"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "genshencp20",
          "title": "原神CP20",
          "icon": "media/genshencp20.svg"
        }
      ]
    },
    "views": {
      "genshencp20": [
        {
          "id": "genshencp20.gallery",
          "name": "皮肤画廊",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Genshin Skin CP1",
      "properties": {
        "genshencp20.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 解释器路径。留散兵自动查找 python / python3。"
        },
        "genshencp20.repoPath": {
          "type": "string",
          "default": "",
          "description": "仓库路径(含 src/genshen_skin_cp20 或 tools/wallpaper.py)。留散兵自动查找 pip 安装与常见克隆位置。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node prepack.js"
  }
}
